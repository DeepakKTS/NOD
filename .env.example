# Nod — every variable in docs/DEPLOYMENT.md §2.
#
# Copy to .env for local development. .env is git-ignored and never committed:
# the AssemblyAI, LLM and TTS keys are server-side only (INV-5).

# `dev` re-raises controller errors after the call ends (INV-8).
NOD_ENV=

# Required. Server-side only; never reaches the browser.
ASSEMBLYAI_API_KEY=

# Confidence-based turn detection. Default: universal-streaming-english
NOD_MODEL=

# Bearer token for mutating routes.
NOD_API_TOKEN=

# `required` | `off`. `off` is local dev only. Default: required
NOD_AUTH=

# CORS allow-list, comma-separated. Never `*`. Default: the console origin
NOD_ALLOWED_ORIGINS=

# Sessions per worker. Default: 64
NOD_MAX_SESSIONS=

# Default latency ceiling, milliseconds. Default: 2600
NOD_CEILING_MS=

# Default preset. Default: balanced
NOD_PRESET=

# `1` disables trace redaction and requires a documented reason (INV-6).
# Default: 0
NOD_TRACE_RAW=

# On the persistent volume. Default: /data/traces
NOD_TRACE_DIR=

# TTS and bench caches. Default: /data/.nodcache
NOD_CACHE_DIR=

# SQLite index, WAL mode. Default: /data/nod.db
NOD_DB_PATH=

# structlog level. Default: info
NOD_LOG_LEVEL=

# Agent brain.
LLM_PROVIDER=
LLM_API_KEY=

# Comma-separated fallback chain, in order. Default: browser
TTS_PROVIDERS=

# One per cloud provider, e.g. TTS_API_KEY_ELEVENLABS. Resolved at P7.
TTS_API_KEY_=

# Validation only, slower (ADR-002). Default: 0
NOD_EXACT_QUANTILES=

# Default mode for new sessions. docs/DEPLOYMENT.md §5 step 1 deploys with
# `observe`; the variable is named there but absent from the §2 table.
# Default: adapt
NOD_MODE_DEFAULT=
