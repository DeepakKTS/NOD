# Nod — every variable in docs/DEPLOYMENT.md §2.
#
# Copy to .env and it works as-is: `cp .env.example .env` reproduces the
# documented defaults exactly. .env is git-ignored and never committed, because
# the AssemblyAI, LLM and TTS keys are server-side only (INV-5).
#
# Typed variables carry their documented default as a real value rather than an
# empty string. An empty string is not "unset" to a typed parser — it is an
# invalid int, bool, enum or Literal, and nine of these crashed on a first run
# before this file was fixed. Only the credentials, which have no default, are
# left blank.

# `dev` re-raises controller errors after the call ends (INV-8). `dev` | `prod`
NOD_ENV=prod

# Required. Server-side only; never reaches the browser.
ASSEMBLYAI_API_KEY=

# Confidence-based turn detection.
NOD_MODEL=universal-streaming-english

# Bearer token for mutating routes.
NOD_API_TOKEN=

# Auth is cut and `require_bearer` is a stub (ADR-042); no route enforces
# this. `required` | `off`
NOD_AUTH=off

# CORS allow-list, comma-separated. Never `*`. Empty means deny every origin.
NOD_ALLOWED_ORIGINS=

# Concurrent sessions per worker, 429 above it. 5 upstream streams permitted
# (measured), 2 held per session during rotation (ADR-042).
NOD_MAX_SESSIONS=2

# Default latency ceiling, milliseconds.
NOD_CEILING_MS=2600

# Default preset.
NOD_PRESET=balanced

# Default mode for new sessions. docs/DEPLOYMENT.md §5 step 1 deploys with
# `observe` as the safe first step. `adapt` | `observe` | `off`
NOD_MODE_DEFAULT=adapt

# `1` disables trace redaction and requires a documented reason (INV-6).
NOD_TRACE_RAW=0

# On the persistent volume.
NOD_TRACE_DIR=/data/traces

# TTS and bench caches.
NOD_CACHE_DIR=/data/.nodcache

# SQLite index, WAL mode.
NOD_DB_PATH=/data/nod.db

# structlog level.
NOD_LOG_LEVEL=info

# Agent brain.
LLM_PROVIDER=
LLM_API_KEY=

# Comma-separated fallback chain, in order. `browser` needs no key.
TTS_PROVIDERS=browser

# One per cloud provider, e.g. TTS_API_KEY_ELEVENLABS. Commented out because the
# name is a family, not a single key; uncomment the ones you use.
# TTS_API_KEY_ELEVENLABS=

# Validation only, slower (ADR-002).
NOD_EXACT_QUANTILES=0
